---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="그래프 — Astronet"
  description="문서 간 관계를 살펴봅니다."
  surface="dark"
  mainClass="graph-main"
>
  <section class="graph-workspace" aria-labelledby="graph-title">
    <header class="graph-toolbar">
      <h1 id="graph-title">그래프</h1>
      <label class="weak-edge-control">
        <input id="graph-weak-edges" type="checkbox" checked />
        <span>약한 연결</span>
      </label>
    </header>

    <div class="graph-canvas" id="graph-canvas-wrap">
      <canvas
        id="graph-canvas"
        tabindex="0"
        role="application"
        aria-label="3D 문서 그래프. 드래그하거나 방향키로 이동하고, 휠, 핀치 또는 더하기와 빼기 키로 부드럽게 확대할 수 있습니다. 어떤 배율에서도 문서 노드를 선택해 자세히 볼 수 있습니다."
      ></canvas>
      <div class="graph-labels" id="graph-labels" aria-hidden="true"></div>
      <p class="graph-status" id="graph-status" role="status">그래프를 불러오는 중입니다.</p>
    </div>

    <aside class="graph-node-panel" id="graph-node-panel" aria-labelledby="graph-node-title" aria-live="polite" hidden>
      <h2 id="graph-node-title"></h2>
      <a id="graph-node-open" href="/">자세히 보기</a>
    </aside>

    <div class="graph-zoom-controls" aria-label="그래프 확대와 축소">
      <button id="graph-zoom-in" type="button" aria-label="확대">+</button>
      <button id="graph-zoom-out" type="button" aria-label="축소">−</button>
    </div>
  </section>
</SiteLayout>

<script>
  import '../scripts/graph-runtime';
</script>

<style>
  :global(.graph-main) {
    overflow: hidden;
  }

  .graph-workspace {
    position: relative;
    min-height: calc(100svh - var(--header-height));
    overflow: hidden;
    background: var(--color-surface-dark);
  }

  .graph-toolbar {
    position: absolute;
    z-index: 3;
    top: var(--space-6);
    right: var(--page-gutter);
    left: var(--page-gutter);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    pointer-events: none;
  }

  .graph-toolbar h1,
  .weak-edge-control {
    pointer-events: auto;
  }

  .graph-toolbar h1 {
    margin: 0;
    color: var(--color-on-dark);
    font-size: var(--font-size-title-lg);
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .weak-edge-control {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius-sm);
    background: rgb(29 31 37 / 92%);
    color: rgb(255 255 255 / 76%);
    font-size: var(--font-size-utility);
  }

  .weak-edge-control input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: #fff;
  }

  .graph-canvas {
    position: absolute;
    inset: 0;
  }

  .graph-canvas canvas {
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .graph-canvas canvas.is-dragging {
    cursor: grabbing;
  }

  .graph-labels {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :global(.graph-label) {
    position: absolute;
    top: 0;
    left: 0;
    max-width: 220px;
    overflow: hidden;
    color: rgb(255 255 255 / 78%);
    font-size: 12px;
    line-height: 18px;
    text-overflow: ellipsis;
    white-space: nowrap;
    will-change: transform;
  }

  .graph-status {
    position: absolute;
    z-index: 2;
    bottom: var(--space-6);
    left: 50%;
    min-height: 44px;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    transform: translateX(-50%);
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: var(--radius-sm);
    background: rgb(29 31 37 / 92%);
    color: rgb(255 255 255 / 72%);
    font-size: var(--font-size-utility);
    white-space: nowrap;
  }

  .graph-node-panel {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    width: min(300px, calc(100% - (var(--space-4) * 2)));
    padding: var(--space-4);
    transform: translate(-50%, calc(-100% - 16px));
    border: 1px solid rgb(255 255 255 / 24%);
    border-radius: var(--radius-md);
    background: rgb(29 31 37 / 98%);
    box-shadow: 0 12px 32px rgb(0 0 0 / 34%);
    color: var(--color-on-dark);
  }

  .graph-node-panel::after {
    position: absolute;
    bottom: -7px;
    left: var(--graph-popover-pointer-x, 50%);
    width: 12px;
    height: 12px;
    transform: translateX(-50%) rotate(45deg);
    border-right: 1px solid rgb(255 255 255 / 24%);
    border-bottom: 1px solid rgb(255 255 255 / 24%);
    background: var(--color-surface-dark-elevated);
    content: '';
  }

  .graph-node-panel.is-below {
    transform: translate(-50%, 16px);
  }

  .graph-node-panel.is-below::after {
    top: -7px;
    bottom: auto;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 24%);
    border-left: 1px solid rgb(255 255 255 / 24%);
  }

  .graph-node-panel h2 {
    margin: 0 0 var(--space-4);
    color: var(--color-on-dark);
    font-size: var(--font-size-title-sm);
    font-weight: 500;
    line-height: 1.45;
  }

  .graph-node-panel a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding-inline: var(--space-4);
    border: 1px solid rgb(255 255 255 / 88%);
    border-radius: var(--radius-sm);
    background: var(--color-on-dark);
    color: var(--color-surface-dark);
    cursor: pointer;
    font-size: var(--font-size-utility);
    font-weight: 600;
    text-decoration: none;
  }

  .graph-node-panel a:active {
    background: rgb(255 255 255 / 82%);
  }

  .graph-node-panel a:focus-visible {
    outline-offset: 2px;
  }

  .graph-zoom-controls {
    position: absolute;
    z-index: 3;
    bottom: var(--space-6);
    left: var(--page-gutter);
    display: flex;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: var(--radius-sm);
    background: rgb(29 31 37 / 92%);
  }

  .graph-zoom-controls button {
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    color: var(--color-on-dark);
    cursor: pointer;
    font-size: var(--font-size-title-md);
  }

  .graph-zoom-controls button + button {
    border-left: 1px solid rgb(255 255 255 / 20%);
  }

  @media (max-width: 600px) {
    .graph-toolbar {
      top: var(--space-4);
    }

    .graph-node-panel {
      width: min(280px, calc(100% - (var(--space-4) * 2)));
    }

    :global(.graph-label) {
      max-width: 160px;
      font-size: 11px;
    }

    .graph-status {
      bottom: calc(var(--space-6) + 52px);
      max-width: calc(100% - (var(--page-gutter) * 2));
      white-space: normal;
    }
  }

  @media (forced-colors: active) {
    .graph-node-panel,
    .weak-edge-control,
    .graph-zoom-controls {
      border: 1px solid CanvasText;
    }
  }
</style>
