{
  "name": "astronet",
  "version": "0.1.0",
  "description": "A read-only worldbuilding wiki built with Astro.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:compile": "tsx scripts/compile-content.ts",
    "dev": "npm run content:compile && astro dev",
    "build": "npm run content:compile && astro build",
    "typecheck": "npm run content:compile && tsc --noEmit",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "pretendard": "^1.3.9",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "image-size": "^2.0.2",
    "saxes": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
